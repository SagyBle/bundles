<script src="{{ 'hello.js' | asset_url }}" defer></script>




<script>
// ✅ Call the imported function
  document.addEventListener("DOMContentLoaded", function () {
      if (window.printHelloWorld) {
          window.printHelloWorld(); // Should log "Hello, World!" in console
      } else {
          console.error("❌ printHelloWorld is not loaded!");
      }
  });
  // Parse the metafield JSON string
  let relatedStones = `{{ product.metafields.custom.relatedstones }}`; // Escape to prevent syntax error
  let chosenStone = null; // Default: No stone is chosen

  function setChosenStone(stone) {
      chosenStone = stone;
      // chosenStoneTitle.innerText = `${stone.carat}ct ${stone.color}, ${stone.cut} - ${stone.price}$`;
      console.log("✅ Chosen Stone Updated:", chosenStone);
      document.getElementById("chosen-stone-title").innerText = chosenStone.productId;

    }


  relatedStones = JSON.parse(relatedStones)
  const printRelatedStones =  () => {
    console.log("Related Stones:",relatedStones);
  }
  if (relatedStones && relatedStones.stones.length > 0) {
    console.log("✅ Parsed Related Stones:", relatedStones.stones);

    const container = document.getElementById("related-stones-container");

    // Separate stones based on carat size
    const overOneCarat = relatedStones.stones.filter(stone => stone.carat > 1.0);
    const underOrEqualOneCarat = relatedStones.stones.filter(stone => stone.carat <= 1.0);

    function createStoneCard(stone) {
      const card = document.createElement("div");
      card.style = `
        width: 200px;
        height: auto;
        border: 1px solid #ddd;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        padding: 10px;
        text-align: center;
        background-color: #fff;
      `;

      const image = document.createElement("img");
      image.src = stone.image;
      image.alt = stone.stoneId;
      image.style = "width: 100%; border-radius: 10px;";

      const title = document.createElement("h3");
      title.innerText = `${stone.carat}ct ${stone.color}, ${stone.cut} - ${stone.price}$`;
      title.style = "font-size: 14px; margin: 10px 0; color: #333;";

      const button = document.createElement("button");
      button.innerText = "View Details";
      button.style = `
        padding: 8px 15px;
        background-color: #008060;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 14px;
        border-radius: 5px;
      `;
      button.onclick = () => console.log(`✅ Clicked:`, stone);

      card.appendChild(image);
      card.appendChild(title);
      // card.appendChild(price);
      card.appendChild(button);
      card.onclick = () => setChosenStone(stone); // Clicking updates chosen stone

      container.appendChild(card);
    }

    // Create buttons for stones over 1 carat
    // overOneCarat.forEach(stone => createButton(stone, "Over 1 Carat"));
    if (overOneCarat && overOneCarat.length > 0) createStoneCard(overOneCarat[0]);
    if (underOrEqualOneCarat && underOrEqualOneCarat.length > 0) createStoneCard(underOrEqualOneCarat[0]);


  } else {
    console.warn("⚠ No related stones available.");
  }


  window.currentProductId = "{{ product.id }}";

  const createProductProxy = async () => {
    console.log("🚀 Sending request...");

    const requestBody = {
      message: "Hello from Shopify Extension!",
      user: {
        id: "12345",
        name: "Sagy Blecher",
      }
    };

    try {
      const response = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/productspublic", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify(requestBody),
      });


      

      if (!response.ok) {
        throw new Error(`Request failed: ${response.status}`);
      }

      const data = await response.json();
      console.log("✅ Response:", JSON.stringify(data));
      // alert(`✅ Success: ${data.message}`);
    } catch (error) {
      console.error("❌ Fetch Error:", error);
      alert(`❌ Error: ${error.message}`);
    }
  };

  const testProxy = async () => {
    console.log("🚀 Sending request...");

    const requestBody = {
      message: "Hello from Shopify Extension!",
      user: {
        id: "12345",
        name: "Sagy Blecher",
      }
    };

    try {
      const response = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/test", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(requestBody),
      });

      if (!response.ok) {
        throw new Error(`Request failed: ${response.status}`);
      }

      const data = await response.json();
      console.log("✅ Response:", data);
      alert(`✅ Success: ${data.message}`);
    } catch (error) {
      console.error("❌ Fetch Error:", error);
      alert(`❌ Error: ${error.message}`);
    }
  };

  const createBundle = async (secondProductId) => {
    const startTime = Date.now();  

    console.log("🚀 Sending create bundle request...");


    if (chosenStone && chosenStone.productId){
      secondProductId = chosenStone.productId;
    }
    else {
      console.log("You have to choose a stone, in order to create a bundle.");
      alert("You have to choose a stone, in order to create a bundle.");
      return;
    }
    console.log("Creating bundle with:", {firstProductId: window.currentProductId, secondProductId});

    const productName = `💍 {{ product.title | escape }}`;
    const stoneTitle = `💎 ${chosenStone.carat}ct ${chosenStone.color}, ${chosenStone.cut}, ${chosenStone.clarity}`
    const bundleTitle = ` ${productName}  ${stoneTitle}`;
    

    try {
        const responseBundle = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/bundlespublic", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "*",
            },
            body: JSON.stringify({ firstProductId: window.currentProductId, secondProductId: secondProductId || undefined, bundleTitle }),
        });

        if (!responseBundle.ok) {
            throw new Error(`Bundle request failed: ${responseBundle.status}`);
        }

        const dataBundle = await responseBundle.json();
        console.log("✅ sagy200 Bundle response:", dataBundle);

        // Extract variantIdNumeric safely
        const variantId = dataBundle?.data?.variantId;
        const variantIdNumeric = dataBundle?.data?.variantIdNumeric;

        if (!variantIdNumeric) {
            throw new Error("❌ Error: Variant ID is missing or invalid.");
        }

        console.log("✅ Extracted variantId:", variantId);
        console.log("✅ Extracted variantIdNumeric:", variantIdNumeric);

            setTimeout(() => {
        addBundleToCart(variantIdNumeric, startTime);
        }, 500);

    } catch (error) {
        console.error("❌ Fetch Error:", error);
        alert(`❌ Error: ${error.message}`);
    }
};


  
  // NOTICE: Put numeric variant id number
  // ✅ Add Product to Cart (Mock Bundle ID)
  const addBundleToCart = async (variantId, startTime) => {
    console.log("🚀 Adding bundle to cart...", typeof variantId, variantId);

    try {
      const response = await fetch("/cart/add.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1,
        }),
      });

      if (!response.ok) {
        throw new Error(`Failed to add product to cart: ${response.status}`);
      }

      const data = await response.json();

      const endTime = Date.now();  // Stop the timer
      const elapsedTime = (endTime - startTime) / 1000;  // Convert to seconds

      console.log("✅ Product added to cart:", data, "total time:", elapsedTime);
      alert(`✅ Bundle added to cart!`);
    } catch (error) {
      console.error("❌ Error adding product to cart:", error);
      alert(`❌ Error adding bundle to cart: ${error.message}`);
    }
  };



    const extractIdFromGid = (gid) => {
      const idStr = String(gid);

      if (idStr.startsWith("gid://shopify/")) {
        return idStr.split("/").pop() || "";
      }

      return idStr;
    }

  const getCurrentProductId = () => {
  if (window.currentProductId) {
    console.log("✅ Current Product ID:", window.currentProductId);
    return window.currentProductId;
  } else {
    console.error("❌ Error: Unable to retrieve product ID.");
    return null;
  }
};
</script>

