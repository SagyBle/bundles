      console.log("✅ Response:", data);
      alert(`✅ Success: ${data.message}`);
    } catch (error) {
      console.error("❌ Fetch Error:", error);
      alert(`❌ Error: ${error.message}`);
    }
  };

  const createBundle = async () => {
    const startTime = Date.now();  

    console.log("🚀 Sending create bundle request...");

    try {
        const responseBundle = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/bundlespublic", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "*",
            },
            body: JSON.stringify({ firstProductId: window.currentProductId }),
        });

        if (!responseBundle.ok) {
            throw new Error(`Bundle request failed: ${responseBundle.status}`);
        }

        const dataBundle = await responseBundle.json();
        console.log("✅ sagy200 Bundle response:", dataBundle);

        // Extract variantIdNumeric safely
        const variantId = dataBundle?.data?.variantId;
        const variantIdNumeric = dataBundle?.data?.variantIdNumeric;

        if (!variantIdNumeric) {
            throw new Error("❌ Error: Variant ID is missing or invalid.");
        }

        console.log("✅ Extracted variantId:", variantId);
        console.log("✅ Extracted variantIdNumeric:", variantIdNumeric);

            setTimeout(() => {
        addBundleToCart(variantIdNumeric, startTime);
        }, 500);

        // Ensure addBundleToCart is only called when variantIdNumeric is valid
        // await addBundleToCart(variantIdNumeric);

        // alert(`✅ Success: ${dataBundle.message}`);
    } catch (error) {
        console.error("❌ Fetch Error:", error);
        alert(`❌ Error: ${error.message}`);
    }
};


  
  // NOTICE: Put numeric variant id number
  // ✅ Add Product to Cart (Mock Bundle ID)
  const addBundleToCart = async (variantId, startTime) => {
    console.log("🚀 Adding bundle to cart...", typeof variantId, variantId);

    try {
      const response = await fetch("/cart/add.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1,
        }),
      });
      
      if (!response.ok) {
        throw new Error(`Failed to add product to cart: ${response.status}`);
      }

      const data = await response.json();
      const endTime = Date.now();  // Stop the timer
      const elapsedTime = (endTime - startTime) / 1000;  // Convert to seconds
      console.log("✅ Product added to cart:", data, "total time:", elapsedTime);
      alert(`✅ Bundle added to cart!`);
    } catch (error) {
      console.error("❌ Error adding product to cart:", error);
      alert(`❌ Error adding bundle to cart: ${error.message}`);
    }
  };



    const extractIdFromGid = (gid) => {
      const idStr = String(gid);

      if (idStr.startsWith("gid://shopify/")) {
        return idStr.split("/").pop() || "";
      }

      return idStr;
    }

  const getCurrentProductId = () => {
  if (window.currentProductId) {
    console.log("✅ Current Product ID:", window.currentProductId);
    return window.currentProductId;
  } else {
    console.error("❌ Error: Unable to retrieve product ID.");
    return null;
  }
};
