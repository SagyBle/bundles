<!-- ✅ JavaScript for Storefront Actions -->
<script>
  const createProductProxy = async () => {
    console.log("🚀 Sending request...");

    const requestBody = {
      message: "Hello from Shopify Extension!",
      user: {
        id: "12345",
        name: "Sagy Blecher",
      }
    };

    try {
      const response = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/productspublic", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify(requestBody),
      });

      if (!response.ok) {
        throw new Error(`Request failed: ${response.status}`);
      }

      const data = await response.json();
      console.log("✅ Response:", data);
      alert(`✅ Success: ${data.message}`);
    } catch (error) {
      console.error("❌ Fetch Error:", error);
      alert(`❌ Error: ${error.message}`);
    }
  };

  const testProxy = async () => {
    console.log("🚀 Sending request...");

    const requestBody = {
      message: "Hello from Shopify Extension!",
      user: {
        id: "12345",
        name: "Sagy Blecher",
      }
    };

    try {
      const response = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/test", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(requestBody),
      });

      if (!response.ok) {
        throw new Error(`Request failed: ${response.status}`);
      }

      const data = await response.json();
      console.log("✅ Response:", data);
      alert(`✅ Success: ${data.message}`);
    } catch (error) {
      console.error("❌ Fetch Error:", error);
      alert(`❌ Error: ${error.message}`);
    }
  };

  const createBundle = async () => {
    console.log("🚀 Sending create bundle request...");

    try {
      // First request to /bundlespublic
      const responsePublic = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/bundles", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*",
        },
        body: JSON.stringify({}),
      });

      if (!responsePublic.ok) {
        throw new Error(`Public request failed: ${responsePublic.status}`);
      }

      const dataPublic = await responsePublic.json();
      console.log("✅ Response from /bundlespublic:", dataPublic);

      // Second request to /bundles
      const responseBundle = await fetch("https://sagy-test-academy.myshopify.com/apps/checkout-proxy/bundles", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*",
        },
        body: JSON.stringify({}),
      });

      if (!responseBundle.ok) {
        throw new Error(`Bundle request failed: ${responseBundle.status}`);
      }

      const dataBundle = await responseBundle.json();
      console.log("✅ Response from /bundles:", dataBundle);

      alert(`✅ Success: ${dataPublic.message}, ${dataBundle.message}`);
    } catch (error) {
      console.error("❌ Fetch Error:", error);
      alert(`❌ Error: ${error.message}`);
    }
  };

  // ✅ Add Product to Cart (Mock Bundle ID)
  const addBundleToCart = async () => {
    console.log("🚀 Adding bundle to cart...");

    // Mock Bundle Product ID (Replace with actual ID from bundle creation response)
    // NOTICE: Put numeric variant id number
    const variantId = "50613593375007"; 

    try {
      const response = await fetch("/cart/add.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id: variantId, // Shopify Variant ID
          quantity: 1,
        }),
      });

      console.log("sagy17", response);
      

      if (!response.ok) {
        throw new Error(`Failed to add product to cart: ${response.status}`);
      }

      const data = await response.json();
      console.log("✅ Product added to cart:", data);
      alert(`✅ Bundle added to cart!`);
    } catch (error) {
      console.error("❌ Error adding product to cart:", error);
      alert(`❌ Error adding bundle to cart: ${error.message}`);
    }
  };
</script>

